{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and progress data",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "username": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "geminiApiKey": { "type": "string" },
        "onboardingReason": { "type": "string" },
        "points": { "type": "number" },
        "streak": { "type": "number" },
        "premiumUnlocked": { "type": "boolean" },
        "lastActive": { "type": "string", "format": "date-time" },
        "bio": { "type": "string" }
      },
      "required": ["uid", "username", "displayName", "points"]
    },
    "Resource": {
      "title": "Resource",
      "description": "Shared study resource",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string" },
        "date": { "type": "string" },
        "url": { "type": "string" },
        "fileData": { "type": "string" },
        "fileName": { "type": "string" },
        "fileSize": { "type": "number" },
        "addedBy": { "type": "string" }
      },
      "required": ["title", "type", "date"]
    },
    "Action": {
      "title": "Action",
      "description": "Recent study action by a user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "text", "timestamp"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Notice bulletin posted by an admin",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "category": { "type": "string" },
        "timestamp": { "type": "string" },
        "author": { "type": "string" }
      },
      "required": ["text", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/resources": {
      "schema": "Resource",
      "description": "Shared study resources"
    },
    "/actions": {
      "schema": "Action",
      "description": "Live feed of study actions"
    },
    "/announcements/{announcementId}": {
      "schema": "Announcement",
      "description": "Admin notice bulletins"
    }
  }
}
